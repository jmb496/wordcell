{
  "name": "wordcell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-dictionary.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-dictionary.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:dictionary": "node scripts/build-dictionary.mjs --force",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p src/engine/tsconfig.json && tsc -p tsconfig.arch.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pretest": "node scripts/build-dictionary.mjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/build-dictionary.mjs",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/build-dictionary.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run check && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
